# Copy this file to `.env` and fill in values. Never commit real API keys.

DATABASE_URL="file:./dev.db"

# From https://platform.openai.com/api-keys (paste the full secret only in `.env`, not here)
OPENAI_API_KEY=

OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# From https://tavily.com/api (Tavily web search integration)
TAVILY_API_KEY=

# From https://console.picovoice.ai (free account, required for wake word detection)
PORCUPINE_ACCESS_KEY=
