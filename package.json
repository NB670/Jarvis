{
  "name": "jarvis",
  "version": "0.1.0",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "electron:dev": "concurrently \"next dev -p 3737\" \"wait-on http://localhost:3737 && electron .\"",
    "electron:build": "next build && (cp -r public .next/standalone/public 2>/dev/null || true) && cp -r .next/static .next/standalone/.next/static && DATABASE_URL=file:$(pwd)/prisma/prod.db npx prisma migrate deploy && electron-builder"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "electron-store": "^8.2.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.7",
    "concurrently": "^10.0.0",
    "dotenv": "^17.4.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "postinstall": "prisma generate"
}
